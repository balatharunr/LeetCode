class Solution {
    public void rotate(int[] nums, int k) {
        int n = nums.length;
        k%=n;
        int temp[] = new int[n]; 
        int j = n - k;
        for(int i = 0; i < k; i++) temp[i] = nums[j++];
        j = 0;
        for(int i = k; i< n; i++) temp[i] = nums[j++];
        for(int i = 0; i < n; i++) nums[i] = temp[i];
    }
}